# Required Django settings
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
SITE_URL=http://127.0.0.1:8000

# Production deployment
# Render sets RENDER_EXTERNAL_HOSTNAME automatically. DATABASE_URL is supplied
# by PostgreSQL; do not commit its value or a production SECRET_KEY.
# ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# DATABASE_URL=postgresql://user:password@host:5432/database
# DEFAULT_FROM_EMAIL=Dunia <no-reply@example.com>
# SITE_URL=https://example.com
# DEBUG=False
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# Durable private object storage for production uploads (S3-compatible).
# Keep the bucket private; public media URLs are signed and private course files
# remain protected by Django's enrollment/admin checks.
# USE_S3=True
# AWS_STORAGE_BUCKET_NAME=your-private-bucket
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=your-storage-access-key
# AWS_SECRET_ACCESS_KEY=your-storage-secret-key
# AWS_QUERYSTRING_EXPIRE=3600

# First generate a key pair with: python manage.py generate_vapid_keys
# Keep the private key secret and configure it only in the server environment.
# WEBPUSH_ENABLED=True
# WEBPUSH_VAPID_PUBLIC_KEY=generated-public-key
# WEBPUSH_VAPID_PRIVATE_KEY=generated-private-key
WEBPUSH_CONTACT_EMAIL=duniaelearningcongo@gmail.com

# Until a verified Mobile Money integration is selected, payments are declared
# by the learner and manually reviewed in Django admin.
MOBILE_MONEY_INSTRUCTIONS=Contactez Dunia via WhatsApp pour obtenir les coordonnées de paiement officielles.
